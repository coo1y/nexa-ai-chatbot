# Copy to .env and adjust. Every variable is optional; defaults run fully offline (mock model).
# See docs/configuration.md for the full list.

# --- AI model provider (any OpenAI-compatible endpoint serving open-source models) ---
LLM_PROVIDER=openai_compatible          # or "mock"
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=                            # e.g. a Groq / OpenRouter / Together API key
MODEL_FAST=llama-3.3-70b-versatile
MODEL_REASONING=openai/gpt-oss-120b
MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
LLM_MAX_RETRIES=3
# SAFETY_MODEL=meta-llama/llama-guard-4-12b

# --- Web search ---
SEARCH_PROVIDER=duckduckgo              # duckduckgo (no key) | tavily | mock
# TAVILY_API_KEY=

# --- Ops ---
# OPS_TOKEN=change-me                   # protects GET /api/v1/metrics
# POSTGRES_PASSWORD=choose-a-strong-one
